# The Collector: manual API requests
#
# Choose an environment (dev or prod) in the dropdown next to the run button.
# Variables (host, name, email, password) come from http-client.env.json
# and http-client.private.env.json.
#
# Run "Log in" first. It saves the token and the user id for the other requests.

@findId = 1


### ---------- Open endpoints (no token needed) ----------

### Index
GET {{host}}/

### Healthcheck
GET {{host}}/auth/healthcheck

### Get all categories
GET {{host}}/categories


### ---------- Users and login ----------

### Create new user
POST {{host}}/users
Content-Type: application/json

{
  "name": "{{name}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Log in (saves token and user id)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set("token", response.body.token);
    client.global.set("userId", response.body.userId);
%}

### Get user by id
GET {{host}}/users/{{userId}}
Authorization: Bearer {{token}}


### ---------- Finds (token needed) ----------

### Create new find
POST {{host}}/finds
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "date": "2026-07-12",
  "photoURL": "billede",
  "note": "En hulsten fra Roskilde.",
  "categoryIds": [1]
}

### Get all finds by user
GET {{host}}/users/{{userId}}/finds
Authorization: Bearer {{token}}

### Get find by id
GET {{host}}/users/{{userId}}/finds/{{findId}}
Authorization: Bearer {{token}}

### Update find (only the fields you send are changed)
PATCH {{host}}/users/{{userId}}/finds/{{findId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "note": "DET HER ER EN FLOT STEN!"
}

### Delete find
DELETE {{host}}/users/{{userId}}/finds/{{findId}}
Authorization: Bearer {{token}}
